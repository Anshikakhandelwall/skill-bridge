# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI — used by every AI agent (Resume Analyst, Career Planner, Adaptation
# Agent, GitHub Analyst, Project Coach, Interview Agent)
OPENAI_API_KEY=

# Optional: an app-owned GitHub Personal Access Token (no scopes needed).
# Raises the GitHub REST API rate limit for the GitHub Evidence Engine from
# 60 req/hr (unauthenticated) to 5,000 req/hr. Not user OAuth — public data only.
GITHUB_TOKEN=

# Optional: override the model used by each agent. All default to gpt-4.1-mini.
OPENAI_RESUME_ANALYST_MODEL=
OPENAI_CAREER_PLANNER_MODEL=
OPENAI_ADAPTATION_AGENT_MODEL=
OPENAI_GITHUB_ANALYST_MODEL=
OPENAI_PROJECT_COACH_MODEL=
OPENAI_INTERVIEW_QUESTION_MODEL=
OPENAI_INTERVIEW_EVALUATION_MODEL=
